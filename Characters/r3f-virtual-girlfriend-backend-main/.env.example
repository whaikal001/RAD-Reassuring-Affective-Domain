# LLM Provider: "openai" or "deepseek"
LLM_PROVIDER=openai

# OpenAI API Key
OPENAI_API_KEY=sk-XXX

# Deepseek API Key (for LLM_PROVIDER=deepseek)
DEEPSEEK_API_KEY=XXX

# Deepseek Base URL (default: https://api.deepseek.com/v1)
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ElevenLabs API Key
ELEVEN_LABS_API_KEY=XXX