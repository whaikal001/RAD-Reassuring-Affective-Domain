# HuggingFace API Configuration
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Chat & TTS Models
HF_CHAT_MODEL=meta-llama/Llama-3.1-8B-Instruct
HF_TTS_MODEL_EN=facebook/fastspeech2-en-ljspeech
HF_TTS_MODEL_MS=microsoft/speecht5_tts

# Emotion Detection & Daily Tracking
HF_EMOTION_MODEL=j-hartmann/emotion-english-distilroberta-base

# Pre-screening Classification (DASS indicators)
HF_SCREENING_MODEL=facebook/bart-large-mnli

# Safety & Toxicity Detection
HF_SAFETY_MODEL=unitary/toxic-bert

# Database Configuration
POSTGRES_USER=radai_user
POSTGRES_PASSWORD=radai_password
POSTGRES_DB=radai

# Application Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/radai
SPRING_DATASOURCE_USERNAME=radai_user
SPRING_DATASOURCE_PASSWORD=radai_password

# Google Sign-In ------------------------------------------------------------
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web app).
# Authorized JavaScript origin: http://localhost:4200 (and your prod origin).
# Paste the SAME value into Frontend/src/environments/environment.ts -> googleClientId
GOOGLE_CLIENT_ID=

# Email Verification (Gmail SMTP) -------------------------------------------
# Requires 2-Step Verification ON, then Google Account > Security > App passwords.
MAIL_USERNAME=youraddress@gmail.com
MAIL_PASSWORD=your_16_char_app_password
# Gmail sends as the authenticated account, so set this to the same address.
APP_MAIL_FROM=youraddress@gmail.com
# Base URL the verification link points to (the address you open in the browser).
# Direct dev run: http://localhost:4200  |  docker-compose frontend: http://localhost:3000
APP_FRONTEND_URL=http://localhost:4200
