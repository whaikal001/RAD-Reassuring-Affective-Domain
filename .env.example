# HuggingFace API Configuration
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Chat & TTS Models
HF_CHAT_MODEL=meta-llama/Llama-3.1-8B-Instruct
HF_TTS_MODEL_EN=facebook/fastspeech2-en-ljspeech
HF_TTS_MODEL_MS=microsoft/speecht5_tts

# Emotion Detection & Daily Tracking
HF_EMOTION_MODEL=j-hartmann/emotion-english-distilroberta-base

# Pre-screening Classification (DASS indicators)
HF_SCREENING_MODEL=facebook/bart-large-mnli

# Safety & Toxicity Detection
HF_SAFETY_MODEL=unitary/toxic-bert

# Database Configuration
POSTGRES_USER=radai_user
POSTGRES_PASSWORD=radai_password
POSTGRES_DB=radai

# Application Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/radai
SPRING_DATASOURCE_USERNAME=radai_user
SPRING_DATASOURCE_PASSWORD=radai_password
